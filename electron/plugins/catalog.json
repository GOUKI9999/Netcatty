[
  {
    "id": "com.netcatty.starter",
    "version": "0.1.2",
    "name": "Plugin Starter",
    "description": "First-party greeting panel, local settings and commands, without terminal or secret access.",
    "author": "Netcatty",
    "repository": "binaricat/Netcatty",
    "commit": "f4a6b205adca486d4e9cda0270e13a9ff0afd7be",
    "license": "GPL-3.0-or-later",
    "readme": "examples/plugins/starter-netcatty/README.md",
    "manifest": {
      "manifestVersion": 1,
      "id": "com.netcatty.starter",
      "name": "starter-netcatty",
      "displayName": {
        "en": "Plugin Starter",
        "zh-CN": "插件入门"
      },
      "description": "First-party settings and command example. No terminal, network, filesystem or secret access.",
      "version": "0.1.2",
      "publisher": "netcatty",
      "license": "GPL-3.0-or-later",
      "engines": {
        "netcatty": ">=0.0.0",
        "api": ">=0.1.0-internal.1 <0.2.0"
      },
      "main": {
        "browser": "dist/index.js"
      },
      "activationEvents": [
        "onCommand:com.netcatty.starter.greet",
        "onView:com.netcatty.starter.panel"
      ],
      "permissions": {
        "required": [
          "commands",
          "settings.read",
          "menus",
          "views"
        ],
        "optional": []
      },
      "contributes": {
        "settings": [
          {
            "id": "com.netcatty.starter.greeting",
            "label": {
              "en": "Greeting",
              "zh-CN": "问候语"
            },
            "description": "A local preference for the example command.",
            "control": "text",
            "scope": "application",
            "default": "Hello, synthetic world!"
          }
        ],
        "commands": [
          {
            "id": "com.netcatty.starter.greet",
            "title": {
              "en": "Starter: Read Greeting",
              "zh-CN": "入门：读取问候语"
            }
          }
        ],
        "menus": [
          {
            "command": "com.netcatty.starter.greet",
            "location": "commandPalette",
            "group": "examples"
          }
        ],
        "views": [
          {
            "id": "com.netcatty.starter.panel",
            "title": {
              "en": "Starter: Greeting Panel",
              "zh-CN": "入门：问候面板"
            },
            "location": "modal"
          }
        ]
      },
      "features": {
        "required": [
          "metadata.brand-icon"
        ]
      },
      "icon": {
        "kind": "package",
        "light": "assets/logo-light.png",
        "dark": "assets/logo-dark.png"
      }
    }
  },
  {
    "id": "com.netcatty.hello",
    "version": "0.1.0",
    "name": "Hello Netcatty",
    "description": "First-party example: greeting settings, commands and terminal providers. Build locally and import.",
    "author": "Netcatty",
    "repository": "binaricat/Netcatty",
    "commit": "4336f8fd53a05a48d6bbc9ad3ce0ca88b121862f",
    "license": "GPL-3.0-or-later",
    "readme": "examples/plugins/hello-netcatty/README.md",
    "manifest": {
      "$schema": "../../../packages/plugin-contract/schema/plugin-contract.schema.json",
      "manifestVersion": 1,
      "id": "com.netcatty.hello",
      "name": "hello-netcatty",
      "displayName": {
        "en": "Hello Netcatty",
        "zh-CN": "你好，Netcatty"
      },
      "description": "Minimal plugin contract and SDK example.",
      "version": "0.1.0",
      "publisher": "netcatty",
      "license": "GPL-3.0-or-later",
      "engines": {
        "netcatty": ">=0.0.0",
        "api": ">=0.1.0-internal <0.2.0"
      },
      "main": {
        "browser": "dist/index.js"
      },
      "activationEvents": [
        "onCommand:com.netcatty.hello.sayHello",
        "onProvider:com.netcatty.hello.completion",
        "onProvider:com.netcatty.hello.decoration",
        "onProvider:com.netcatty.hello.theme"
      ],
      "permissions": {
        "required": [
          "commands",
          "settings.read",
          "menus",
          "provider.terminal",
          "terminal.complete",
          "terminal.output",
          "terminal.decorate"
        ],
        "optional": []
      },
      "contributes": {
        "settings": [
          {
            "id": "com.netcatty.hello.greeting",
            "label": "Greeting",
            "description": "Text used by the example command.",
            "control": "text",
            "scope": "application",
            "default": "Hello from Netcatty"
          }
        ],
        "commands": [
          {
            "id": "com.netcatty.hello.sayHello",
            "title": "Say Hello",
            "category": "Examples"
          }
        ],
        "menus": [
          {
            "command": "com.netcatty.hello.sayHello",
            "location": "commandPalette",
            "group": "examples",
            "order": 10
          }
        ],
        "providers": [
          {
            "id": "com.netcatty.hello.completion",
            "label": "Hello completion",
            "description": "Suggests the example hello command.",
            "kind": "terminal.completion"
          },
          {
            "id": "com.netcatty.hello.decoration",
            "label": "Hello decoration",
            "description": "Highlights the example greeting in terminal output.",
            "kind": "terminal.decoration"
          },
          {
            "id": "com.netcatty.hello.theme",
            "label": "Hello theme",
            "description": "Adds a subtle cursor color to the example terminal theme.",
            "kind": "terminal.theme"
          }
        ]
      }
    }
  },
  {
    "id": "com.binaricat.netcatty-database",
    "version": "0.3.0",
    "name": "Netcatty Database",
    "description": "Enterprise-grade multi-database IDE inside Netcatty covering 113 engine profiles (76 live pure-TS drivers across 13 families incl. SQL, CQL, Redis, MongoDB, Neo4j, Search/Vector, KV, RabbitMQ/Pulsar/MQTT/Kafka + 37 catalog entries), BI Dashboard across 53 engines (SQL/CQL/HTTP-SQL + MongoDB Aggregation), Catty Agent tools, Server Monitor, Users Admin, Data Compare, Mock Data, Data Dictionary/Model Codegen, Global Search, Dolt VC, and Vault SSH tunnels.",
    "author": "Netcatty",
    "repository": "binaricat/netcatty-database-plugin",
    "commit": "e198669e6a2db84ccdbaa5687464bc77113a08db",
    "license": "GPL-3.0-or-later",
    "readme": "README.md",
    "manifest": {
      "manifestVersion": 1,
      "id": "com.binaricat.netcatty-database",
      "name": "netcatty-database",
      "displayName": {
        "en": "Netcatty Database",
        "zh-CN": "Netcatty 数据库"
      },
      "description": {
        "en": "Enterprise-grade multi-database IDE inside Netcatty covering 113 engine profiles (76 live pure-TS drivers across 13 families incl. SQL, CQL, Redis, MongoDB, Neo4j, Search/Vector, KV, RabbitMQ/Pulsar/MQTT/Kafka + 37 catalog entries), BI Dashboard across 53 engines (SQL/CQL/HTTP-SQL + MongoDB Aggregation), Catty Agent tools, Server Monitor, Users Admin, Data Compare, Mock Data, Data Dictionary/Model Codegen, Global Search, Dolt VC, and Vault SSH tunnels.",
        "zh-CN": "内置于 Netcatty 的全功能企业级多数据库 IDE，覆盖 113 种引擎配置（76 个跨 13 大协议族原生驱动，含 SQL/CQL/Redis/MongoDB/Neo4j/检索向量/KV/RabbitMQ/Pulsar/MQTT/Kafka + 37 个目录引擎），支持 53 种引擎 BI 看板（SQL/CQL/HTTP-SQL + MongoDB 聚合）、Catty Agent 工具、服务监控、用户权限、数据对比、测试数据生成、数据字典与代码生成、全局搜索、Dolt 版本控制与 Vault SSH 隧道。"
      },
      "version": "0.3.0",
      "publisher": "binaricat",
      "license": "GPL-3.0-or-later",
      "engines": {
        "netcatty": ">=0.0.0",
        "api": ">=0.1.0-internal.1 <0.2.0"
      },
      "features": {
        "required": [
          "views.host-drawn",
          "views.vault-pages",
          "metadata.brand-icon",
          "ai.model-invocation",
          "ai.agent-sessions",
          "vault.host-actions",
          "host.interactions",
          "network.byte-streams",
          "network.host-byte-streams"
        ],
        "optional": [
          "ai.sidebar-tools"
        ]
      },
      "main": {
        "browser": "browser.js"
      },
      "activationEvents": [
        "onView:com.binaricat.netcatty-database.workbench",
        "onView:com.binaricat.netcatty-database.connection"
      ],
      "permissions": {
        "required": [
          "views"
        ],
        "optional": [
          "storage",
          "secrets",
          "network.stream",
          "network",
          "clipboard.read",
          {
            "permission": "ai.invoke",
            "resources": [
              "*"
            ],
            "reason": "Draft, explain, optimize, and fix SQL queries using schema metadata / 使用数据库结构生成、解释、优化和修复 SQL 草稿"
          },
          {
            "permission": "ai.agent.use",
            "resources": [
              "*"
            ],
            "reason": "Optional host Agent conversations for database guidance / 可选宿主 Agent 对话以提供数据库辅助"
          },
          {
            "permission": "vault.metadata",
            "resources": [
              "*"
            ],
            "reason": "Select existing Netcatty Vault SSH hosts for database tunneling / 选择已有 Netcatty Vault SSH 主机建立数据库隧道"
          },
          {
            "permission": "ui.interact",
            "resources": [
              "*"
            ],
            "reason": "Open and save local SQLite databases, SQL scripts, and CSV/JSON/XLSX exports via native file dialogs / 通过原生文件对话框打开和保存本地 SQLite、SQL 脚本及数据导出文件"
          },
          {
            "permission": "network.hostStream",
            "resources": [
              "*"
            ],
            "reason": "Connect to remote databases through a user-selected Netcatty Vault SSH server without exposing SSH credentials / 通过选定的 Netcatty Vault SSH 主机隧道连接远端数据库，不暴露 SSH 凭证"
          },
          {
            "permission": "clipboard.write",
            "resources": [
              "*"
            ],
            "reason": "Copy query results, SQL statements, and connection URIs to the clipboard / 复制查询结果、SQL 语句与连接 URI 到剪贴板"
          }
        ]
      },
      "contributes": {
        "views": [
          {
            "id": "com.binaricat.netcatty-database.workbench",
            "title": {
              "en": "Database",
              "zh-CN": "数据库"
            },
            "location": "vault-page",
            "icon": {
              "kind": "theme",
              "name": "database"
            }
          },
          {
            "id": "com.binaricat.netcatty-database.connection",
            "title": {
              "en": "Database: New connection",
              "zh-CN": "数据库：新建连接"
            },
            "location": "modal"
          }
        ]
      },
      "icon": {
        "kind": "package",
        "light": "assets/plugin-icon-light.png",
        "dark": "assets/plugin-icon-dark.png"
      }
    }
  },
  {
    "id": "com.binaricat.netcatty-monitor",
    "version": "0.2.0",
    "name": "Netcatty Monitor",
    "description": "Official agentless SSH fleet monitoring and server operations workbench with real-time CPU, memory, disk I/O, network, GPU & thermal charts, live process explorer, systemd/Docker/Podman services & logs, listening ports, and configurable threshold alerts.",
    "author": "Netcatty",
    "repository": "binaricat/netcatty-monitor-plugin",
    "commit": "b0d3f32f73084ff5098f00bcb813b8755fdf4b8c",
    "license": "GPL-3.0-or-later",
    "readme": "README.md",
    "manifest": {
      "manifestVersion": 1,
      "id": "com.binaricat.netcatty-monitor",
      "name": "netcatty-monitor",
      "displayName": {
        "en": "Netcatty Monitor",
        "zh-CN": "Netcatty 监控"
      },
      "description": {
        "en": "Agentless SSH fleet monitoring and server operations workbench inside Netcatty with real-time CPU, memory, disk I/O, network, GPU & thermal charts, live process explorer, systemd/Docker/Podman services & log tails, listening ports, and configurable threshold alerts.",
        "zh-CN": "内置于 Netcatty 的无 Agent SSH 服务器集群监控与运维工作台，提供实时 CPU、内存、磁盘 I/O、网络、GPU 与温度曲线，以及实时进程管理、systemd/Docker/Podman 服务与日志查看、监听端口分析与可配置阈值告警。"
      },
      "version": "0.2.0",
      "publisher": "binaricat",
      "license": "GPL-3.0-or-later",
      "homepage": "https://github.com/binaricat/netcatty-monitor-plugin",
      "repository": "https://github.com/binaricat/netcatty-monitor-plugin",
      "engines": {
        "netcatty": ">=0.0.0",
        "api": ">=0.1.0-internal.1 <0.2.0"
      },
      "features": {
        "required": [
          "views.host-drawn",
          "views.vault-pages",
          "metadata.brand-icon",
          "vault.host-actions",
          "vault.host-exec",
          "vault.host-probe",
          "host.interactions"
        ]
      },
      "main": {
        "browser": "browser.js"
      },
      "activationEvents": [
        "onView:com.binaricat.netcatty-monitor.workbench"
      ],
      "permissions": {
        "required": [
          "views"
        ],
        "optional": [
          "storage",
          {
            "permission": "vault.metadata",
            "resources": [
              "*"
            ],
            "reason": "Select saved Netcatty Vault hosts and refresh host labels, tags, and groups for monitoring panels / 选择已保存的 Netcatty Vault 主机并刷新监控面板中的主机标签、分组与元信息"
          },
          {
            "permission": "vault.hostExec",
            "resources": [
              "*"
            ],
            "reason": "Run bounded telemetry, process, service, container, and port inspection commands over pooled SSH connections without exposing credentials / 通过宿主复用的 SSH 连接执行受限监控采集与运维诊断命令，不暴露主机凭证"
          },
          {
            "permission": "ui.interact",
            "resources": [
              "*"
            ],
            "reason": "Confirm destructive process, service, container, and panel actions via native dialogs and export JSON/Markdown diagnostic reports / 通过原生确认对话框确认进程、服务、容器及面板操作，并导出 JSON/Markdown 诊断报告"
          },
          {
            "permission": "clipboard.write",
            "resources": [
              "*"
            ],
            "reason": "Copy process commands, host info, and diagnostic log lines to the clipboard / 复制进程命令行、主机信息与诊断日志到剪贴板"
          }
        ]
      },
      "contributes": {
        "views": [
          {
            "id": "com.binaricat.netcatty-monitor.workbench",
            "title": {
              "en": "Monitor",
              "zh-CN": "监控"
            },
            "location": "vault-page",
            "icon": {
              "kind": "theme",
              "name": "activity"
            }
          }
        ]
      },
      "icon": {
        "kind": "package",
        "light": "assets/plugin-icon-light.png",
        "dark": "assets/plugin-icon-dark.png"
      }
    }
  }
]
